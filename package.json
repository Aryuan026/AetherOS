{
  "name": "aetheros",
  "version": "2.0.0",
  "license": "SEE LICENSE IN NOTICE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "frontstage:start": "./scripts/local_ctl.sh start",
    "frontstage:status": "./scripts/local_ctl.sh status",
    "frontstage:stop": "./scripts/local_ctl.sh stop",
    "build": "vite build",
    "build:quiet": "vite build --logLevel warn",
    "typecheck": "tsc --noEmit",
    "verify:narrative": "node --experimental-strip-types scripts/verify-narrative-foundation.ts && node --experimental-strip-types scripts/verify-narrative-director-context.ts",
    "verify:history-import": "tsx scripts/verify-history-import.ts",
    "verify:daily-archive": "tsx scripts/verify-daily-archive.ts",
    "verify:appearance-presets": "tsx scripts/verify-appearance-presets.ts",
    "verify:shell-chrome": "tsx scripts/verify-shell-chrome.ts",
    "verify:virtual-world-clock": "tsx scripts/verify-virtual-world-clock.ts",
    "verify:chat-reply-mode": "tsx scripts/verify-chat-reply-mode.ts",
    "verify:public-release": "node --experimental-strip-types scripts/verify-public-release.ts",
    "verify:health": "npm run verify:public-release && npm run typecheck && npm run build:quiet",
    "preview": "vite preview",
    "mock:api": "node scripts/mock-openai-server.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@fontsource/quicksand": "^5.2.8",
    "@neondatabase/serverless": "^1.0.2",
    "@netlify/blobs": "^10.7.4",
    "@netlify/functions": "^5.1.5",
    "@phosphor-icons/react": "^2.1.10",
    "@rei-standard/amsg-client": "^2.0.1",
    "@rei-standard/amsg-server": "^2.0.1",
    "@rei-standard/amsg-sw": "^2.0.1",
    "jszip": "^3.10.1",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
